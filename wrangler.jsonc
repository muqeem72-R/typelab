// TypeLab on Cloudflare Workers: the website is served as static files, and one small Worker answers /api/*.
// `npx wrangler deploy` (the deploy command of a Workers Builds project) reads this file.
{
  // Must be the same as the Worker's name in the Cloudflare dashboard.
  "name": "typelab",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",

  // Variables added in the dashboard (MAIL_PROVIDER, MAIL_FROM) are kept when this file is deployed again.
  "keep_vars": true,

  "assets": {
    // The repository root is the website. .assetsignore lists what is not part of it.
    "directory": ".",
    // Only /api/* runs the Worker; every other address is a plain static file.
    "run_worker_first": ["/api/*"]
  },

  // The leaderboard and login codes. Wrangler created this namespace on the first deploy; the id is written
  // here so that no later deploy can create a new, empty one.
  "kv_namespaces": [{ "binding": "TYPELAB", "id": "730464571b7d46a3acb3f4de255771df" }],

  // The site is served at https://typelab.<account>.workers.dev. Preview URLs are off: they would reach the
  // same KV namespace and secrets as the real site.
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true }
}
